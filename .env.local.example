# Clerk Authentication (get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex Backend (get from https://dashboard.convex.dev)
VITE_CONVEX_URL=https://small-crocodile-279.convex.cloud

# AI API Keys (optional - for evaluation features)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Note: The following must be set in the Convex Dashboard
# Environment Variables section, not in this file:
